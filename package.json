{
  "name": "chhaya",
  "version": "1.0.0",
  "description": "Chhaya - Heatwave & Cooling Center Management System",
  "scripts": {
    "setup": "npm run install:all",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "seed:manager": "npm --prefix backend run seed:manager"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harshil2308/Chhaya.git"
  },
  "keywords": [
    "heatwave",
    "cooling-centers",
    "react",
    "express",
    "mongodb"
  ],
  "author": "",
